{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "troxe",
    "type": "theme",
    "name": "Troxe",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0"
    },
    "description": "Troxe Hosting identity: refined monochrome surfaces with hairline depth and semantic color accents, inspired by new-troxe-hosting.",
    "author": "Troxe Hosting",
    "icon": "palette",
    "ui": {
        "entry": "dist/client.js"
    },
    "theme": {
        "extends": "classic",
        "stylesheet": "dist/theme.css",
        "schemes": [
            "dark",
            "light"
        ],
        "settings": {
            "logo": {
                "type": "image",
                "label": "Logo",
                "help": "Shown in place of the panel name. Leave empty to use the bundled Troxe mark.",
                "token": "--brand-logo"
            },
                "primary": {
                    "type": "color",
                    "label": "Accent",
                    "help": "Primary accent: actions, active navigation and highlights. Default matches new-troxe-hosting (white on dark).",
                    "default": "#ffffff",
                    "token": "--troxe-primary",
                    "tab": "States"
                },
            "success": {
                "type": "color",
                "label": "Success",
                "help": "Running servers and successful actions.",
                "default": "#22c55e",
                "token": "--troxe-success",
                "tab": "States"
            },
            "danger": {
                "type": "color",
                "label": "Danger",
                "help": "Offline status, errors and destructive actions.",
                "default": "#ef4444",
                "token": "--troxe-danger",
                "tab": "States"
            },
            "warning": {
                "type": "color",
                "label": "Warning",
                "help": "Starting servers and threshold alerts.",
                "default": "#f59e0b",
                "token": "--troxe-warning",
                "tab": "States"
            },
            "radius": {
                "type": "number",
                "label": "Corner radius",
                "default": 0.75,
                "min": 0,
                "max": 1.5,
                "step": 0.125,
                "unit": "rem",
                "token": "--radius",
                "tab": "Shape"
            },
            "compact": {
                "type": "toggle",
                "label": "Compact spacing",
                "default": false,
                "attribute": "data-troxe-compact",
                "tab": "Shape"
            }
        }
    }
}
